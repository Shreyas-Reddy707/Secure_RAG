# ============================================================================
# SecureRAG Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows)
# ============================================================================

# Primary LLM Provider ("gemini" | "groq" | "deterministic")
# Note: Even if API keys are left blank, SecureRAG automatically falls back
# to its built-in Deterministic Security Engine so live demos never fail.
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API (Recommended: get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq API Fallback (Get key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector Database Settings (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=securerag_hybrid_kb

# Defense Thresholds & Multi-Agent Safeguards
DEFAULT_TOP_K=6
INPUT_BLOCK_THRESHOLD=0.75
CHUNK_TRUST_THRESHOLD=0.60

# Frontend Public Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security, Access Control & Telemetry
DEBUG=false
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
QDRANT_API_KEY=
ADMIN_API_TOKEN=your_secure_admin_api_token_here
